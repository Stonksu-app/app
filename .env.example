# Copy to .env and fill in from your Supabase project:
#   Dashboard > Project Settings > Data API  (URL)
#   Dashboard > Project Settings > API Keys  (anon / publishable key)
#
# Leave both blank and the app runs entirely on localStorage, exactly as it did
# before the backend existed. Nothing breaks; progress just stays on the device.
#
# The anon key is meant to ship in the client — row level security is what
# protects the data. NEVER put the service_role key here: it bypasses RLS and
# anything in a VITE_ variable ends up in the JavaScript bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Qué base de datos es esta, para el aviso del perfil: dev | test | production.
# Vacío se lee como dev. En rigby-branch (entorno de test) pon:
#   VITE_APP_ENV=test
# y arriba la URL y la anon key del proyecto de test, no las de dev.
VITE_APP_ENV=
